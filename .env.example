# Local SQLite file (default). Point at another libsql URL to move it.
DATABASE_URL="file:./dispatch.db"

# Required from milestone 2 on (run engine). Never shipped to the client.
ANTHROPIC_API_KEY=""
# Only needed if the API key is a user-level key not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=""

# M2 test scaffolding only — never set in production.
# DISPATCH_TEST_STUB=1 registers the stub connector (send_test_message) in the registry.
# DISPATCH_TEST_TOOL_LOOP=1 skips model calls: the plan is a single node and the
# node loop directly requests the first approval-required tool, so the approval
# gate, pause/resume, and kill switch can be verified without an API key.
